+            echo '::error::Full external comparison deferred for draft 1T probe; no visual result is claimed. An unmarked full checkpoint is required.'
+            exit 1
+          fi
       - name: Materialize accepted baseline without candidate replacements
         env:
           BASE: ${{ needs.accepted_baseline.outputs.sha }}
